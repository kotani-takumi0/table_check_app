{
  "name": "table-check-app",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @table-check/web",
    "ios": "npm run start -w @table-check/ios",
    "ios:tunnel": "npm run start -w @table-check/ios -- --tunnel",
    "build": "npm run typecheck -w @table-check/core && npm run build -w @table-check/web",
    "test": "npm test --workspaces --if-present",
    "typecheck:ios": "npm run typecheck -w @table-check/ios",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules -P prod"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
